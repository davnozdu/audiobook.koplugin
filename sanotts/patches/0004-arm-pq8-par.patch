# 0004-arm-pq8-par.patch -- pq8 decoder dual-core split via snt_par_run.
#
# Wraps the four decoder oc-loops (pre conv, upsample convtr, residual-bank
# t1 and t2) in snt_par_run ranges split by output channel, with per-core
# rowbuf scratch (rowbuf[2], arena 4N -> 8N) picked by snt_scratch_id().
#
# Bit-exactness: each oc row is computed entirely by one thread; within a
# row the (ic,k) accumulation order is unchanged (the NEON kernels
# parallelize only across disjoint t lanes), and integer addition cannot
# drift.  sumf rows are per-oc disjoint, so the concurrent t2 accumulate is
# safe; the fp32 branch-sum scaling, stage taps and the mix quant run AFTER
# the last snt_par_run barrier on the main thread in the original serial
# order, which preserves bit-exact audio and the .timing sidecar.
#
# SNT_THREADS env selects threading at runtime (unset = fully serial, the
# worker thread is never created).  Gates: dev/snt-ab.sh --ids --cross
# byte identity for serial-vs-pristine and SNT_THREADS=2-vs-1.
#
# Guard (package-for-kobo.sh): grep -q "snt_par_run" src/snt_piperlite_q8.c
# Applied: patch -p1 from inside mcu/.
diff -ruN a/src/snt_piperlite_q8.c b/src/snt_piperlite_q8.c
--- a/src/snt_piperlite_q8.c	2026-10-19 00:09:53.508632833 +0200
+++ b/src/snt_piperlite_q8.c	2026-10-19 00:09:53.510417598 +0200
@@ -22,6 +22,11 @@
