+/* Not in snt_port.h: an extern convention shared with snt_tts.c/snt_nano.c,
+ * defined by the linked port TU (0 main thread, 1 worker). */
+extern int snt_scratch_id(void);
 
 #include <math.h>
 #include <string.h>
@@ -334,13 +339,126 @@
     if (!m || frames <= 0) return 0;
     S = plq_plane_elems(m, frames);
     N = (long)PLQ_HOP * frames;
-    /* sumf (4S) + rowbuf (4N) + 4 int16 planes (2S each) + slack */
-    main_bytes = 4 * S + 4 * N + 8 * S + 64;
+    /* sumf (4S) + 2 per-core rowbufs (2*4N) + 4 int16 planes (2S each) + slack */
+    main_bytes = 4 * S + 8 * N + 8 * S + 64;
     /* post filter reuses the arena as 4 fp32 planes of pf_ch*N */
     pf_bytes = m->pf_channels > 0 ? 16L * m->pf_channels * N + 64 : 0;
     return (size_t)(main_bytes > pf_bytes ? main_bytes : pf_bytes);
 }
 
+/* ---- parallel oc-loops ----------------------------------------------------
+ * Every split below is by output channel: plane rows and sumf rows are
+ * disjoint per oc, rowbuf is per-core scratch picked by snt_scratch_id(),
+ * and the integer conv kernels are order-free, so the 2-thread split cannot
+ * change any integer result.  The fp32 branch-sum scaling, stage taps and
+ * the mix quant stay AFTER the last snt_par_run barrier on the main thread
+ * in the original serial order -- that is what preserves bit-exact output
+ * (and the .timing sidecar) under the split. */
+typedef struct {
+    const snt_piperlite_q8_model *m;
+    const int16_t *in;
+    int16_t *out;
+    int32_t **rowbuf;
+    float s_in, s_out;
+    const float *b;
+    int T;
+} plq_pre_ctx;
+
+static void plq_pre_range(int lo, int hi, void *v) {
+    plq_pre_ctx *c = (plq_pre_ctx *)v;
+    int32_t *rb = c->rowbuf[snt_scratch_id()];
+    int oc, t;
+    for (oc = lo; oc < hi; oc++) {
+        float mm = c->s_in * c->m->wscale[0][oc] / c->s_out;
+        float cc = c->b[oc] / c->s_out;
+        int16_t *orow = c->out + (long)oc * c->T;
+        q16_conv1d_row(rb, c->in, c->m->wq[0] + (long)oc * c->m->in_ch * 7,
+                       c->m->in_ch, c->T, 7, 1);
+        for (t = 0; t < c->T; t++)
+            orow[t] = sat12((float)rb[t] * mm + cc);
+    }
+}
+
+typedef struct {
+    const snt_piperlite_q8_model *m;
+    const int16_t *in;
+    int16_t *out;
+    int32_t **rowbuf;
+    float s_in, s_out;
+    const float *b;
+    int T, out_ch, in_ch, stride, pad, k, L, slot;
+} plq_up_ctx;
+
+static void plq_up_range(int lo, int hi, void *v) {
+    plq_up_ctx *c = (plq_up_ctx *)v;
+    int32_t *rb = c->rowbuf[snt_scratch_id()];
+    int oc, t;
+    for (oc = lo; oc < hi; oc++) {
+        float mm = c->s_in * c->m->wscale[c->slot][oc] / c->s_out;
+        float cc = c->b[oc] / c->s_out;
+        int16_t *orow = c->out + (long)oc * c->L;
+        q16_convtr1d_row(rb, c->in, c->m->wq[c->slot], oc, c->in_ch,
+                         c->out_ch, c->T, c->k, c->stride, c->pad, c->L);
+        for (t = 0; t < c->L; t++)
+            orow[t] = sat12((float)rb[t] * mm + cc);
+    }
+}
+
+typedef struct {
+    const snt_piperlite_q8_model *m;
+    const int16_t *in;
+    const int16_t *res;
+    int16_t *out;
+    int32_t **rowbuf;
+    float s_t1, s_y1, s_res;
+    int L, out_ch, k, dil, slot;
+} plq_t1_ctx;
+
+static void plq_t1_range(int lo, int hi, void *v) {
+    plq_t1_ctx *c = (plq_t1_ctx *)v;
+    int32_t *rb = c->rowbuf[snt_scratch_id()];
+    int oc, t;
+    for (oc = lo; oc < hi; oc++) {
+        float mm = c->s_t1 * c->m->wscale[c->slot][oc] / c->s_y1;
+        float cc = c->m->f32[c->slot + 1][oc] / c->s_y1;
+        float mr = c->s_res / c->s_y1;
+        const int16_t *xrow = c->res + (long)oc * c->L;
+        int16_t *yrow = c->out + (long)oc * c->L;
+        q16_conv1d_row(rb, c->in, c->m->wq[c->slot] + (long)oc * c->out_ch * c->k,
+                       c->out_ch, c->L, c->k, c->dil);
+        for (t = 0; t < c->L; t++)
+            yrow[t] = sat12((float)rb[t] * mm + cc +
+                            (float)xrow[t] * mr);
+    }
+}
+
+typedef struct {
+    const snt_piperlite_q8_model *m;
+    const int16_t *in;
+    const int16_t *res;
+    float *sumf;
+    int32_t **rowbuf;
+    float s_t2, s_y1;
+    int L, out_ch, k, dil, slot;
+} plq_t2_ctx;
+
+static void plq_t2_range(int lo, int hi, void *v) {
+    plq_t2_ctx *c = (plq_t2_ctx *)v;
+    int32_t *rb = c->rowbuf[snt_scratch_id()];
+    int oc, t;
+    for (oc = lo; oc < hi; oc++) {
+        float mm = c->s_t2 * c->m->wscale[c->slot][oc];
+        float cc = c->m->f32[c->slot + 1][oc];
+        const int16_t *yrow = c->res + (long)oc * c->L;
+        float *srow = c->sumf + (long)oc * c->L;
+        q16_conv1d_row(rb, c->in, c->m->wq[c->slot] + (long)oc * c->out_ch * c->k,
+                       c->out_ch, c->L, c->k, c->dil);
+        for (t = 0; t < c->L; t++)
+            srow[t] += (float)rb[t] * mm + cc +
+                       (float)yrow[t] * c->s_y1;
+    }
+}
